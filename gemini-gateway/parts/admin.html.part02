    <div class="tablewrap"><table><thead><tr><th>名称</th><th>Key</th><th>状态</th><th>RPM</th><th>日 Token</th><th>月 Token</th><th>创建时间</th><th>操作</th></tr></thead><tbody id="keyRows"></tbody></table></div>
  </div>
  <div class="card panel"><div class="panelhead"><div><h2>接入地址</h2><div class="small muted" style="margin-top:6px">OpenAI 客户端使用 /v1；需要 Gemini 原生协议时使用 /gemini。</div></div></div><div class="keybox" id="baseUrl"></div></div>
</div>

<div id="createModal" class="modal"><div class="dialog"><h3>创建 API Key</h3><div class="field"><label>名称</label><input id="newName" class="input" placeholder="例如：Muse / 朋友01" /></div><div class="row"><div class="field"><label>RPM</label><input id="newRpm" class="input" type="number" value="60" min="1" /></div><div class="field"><label>每日 Token 上限（0=不限）</label><input id="newDaily" class="input" type="number" value="0" min="0" /></div></div><div class="field"><label>每月 Token 上限（0=不限）</label><input id="newMonthly" class="input" type="number" value="0" min="0" /></div><div class="actions"><button class="btn ghost" onclick="hideCreate()">取消</button><button class="btn" onclick="createKey()">创建</button></div></div></div>
<div id="keyModal" class="modal"><div class="dialog"><h3>API Key 已创建</h3><p class="small muted">只显示这一次，诵立即复制保存。</p><div id="plainKey" class="keybox"></div><div class="actions"><button class="btn ghost" onclick="copyKey()">复制</button><button class="btn" onclick="hideKey()">完成</button></div></div></div>
<div id="toast" class="toast"></div>
<script>
const $=s=>document.querySelector(s); let adminToken=localStorage.getItem('gzg_admin_token')||''; let currentPlain='';
function hdr(){return {'Content-Type':'application/json','X-Admin-Token':adminToken}}
function fmt(n){n=Number(n||0);if(n>=1e9)return(n/1e9).toFixed(2)+'B';if(n>=1e6)return(n/1e6).toFixed(2)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return String(n)}
function toast(s){const el=$('#toast');el.textContent=s;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1700)}
async function api(path,opt={}){opt.headers={...hdr(),...(opt.headers||{})};const r=await fetch(path,opt);if(r.status===401){logout();throw new Error('管理令牌无效')}if(!r.ok){let j={};try{j=await r.json()}catch{}throw new Error(j?.error?.message||('HTTP '+r.status))}if(r.status===204)return null;return r.json()}
async function login(){adminToken=$('#token').value.trim();if(!adminToken)return;localStorage.setItem('gzg_admin_token',adminToken);try{await load();$('#login').classList.add('hidden');$('#app').classList.remove('hidden')}catch(e){toast(e.message)}}
function logout(){localStorage.removeItem('gzg_admin_token');adminToken='';$('#app').classList.add('hidden');$('#login').classList.remove('hidden')}
async function load(){const [s,keys]=await Promise.all([api('/admin/api/stats'),api('/admin/api/keys')]);$('#todayReq').textContent=fmt(s.today_requests);$('#todayTok').textContent=fmt(s.today_tokens);$('#monthTok').textContent=fmt(s.month_tokens);$('#activeKeys').textContent=s.active_keys+'/'+s.keys;$('#baseUrl').textContent='OpenAI: '+location.origin+'/v1\nGemini 原生: '+location.origin+'/gemini';renderKeys(keys)}
function renderKeys(keys){const tb=$('#keyRows');tb.innerHTML='';for(const k of keys){const tr=document.createElement('tr');tr.innerHTML=`<td>${esc(k.name)}</td><td class="mono">${esc(k.prefix)}••••</td><td><span class="status"><span class="dot ${k.enabled?'':'off'}"></span>${k.enabled?'正常':'已禁用'}</span></td><td>${k.rpm}</td><td>${k.daily_token_limit?fmt(k.daily_token_limit):'不限'}</td><td>${k.monthly_token_limit?fmt(k.monthly_token_limit):'不限'}</td><td class="small muted">${new Date(k.created_at).toLocaleString()}</td><td><button class="btn ghost" onclick="toggleKey(${k.id},${!k.enabled})">${k.enabled?'禁用':'启用'}</button> <button class="btn danger" onclick="delKey(${k.id})">删除</button></td>`;tb.appendChild(tr)}}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function showCreate(){$('#createModal').classList.add('show')}function hideCreate(){$('#createModal').classList.remove('show')}
async function createKey(){try{const body={name:$('#newName').value.trim(),rpm:Number($('#newRpm').value||60),daily_token_limit:Number($('#newDaily').value||0),monthly_token_limit:Number($('#newMonthly').value||0)};const x=await api('/admin/api/keys',{method:'POST',body:JSON.stringify(body)});hideCreate();currentPlain=x.key;$('#plainKey').textContent=x.key;$('#keyModal').classList.add('show');await load()}catch(e){toast(e.message)}}
function hideKey(){currentPlain='';$('#plainKey').textContent='';$('#keyModal').classList.remove('show')}
async function copyKey(){await navigator.clipboard.writeText(currentPlain);toast('已复制')}
async function toggleKey(id,enabled){try{await api('/admin/api/keys/'+id,{method:'PATCH',body:JSON.stringify({enabled})});await load()}catch(e){toast(e.message)}}
async function delKey(id){if(!confirm('确定删除这个 Key？删除后立即失效。'))return;try{await api('/admin/api/keys/'+id,{method:'DELETE'});await load()}catch(e){toast(e.message)}}
if(adminToken){load().then(()=>{$('#login').classList.add('hidden');$('#app').classList.remove('hidden')}).catch(()=>logout())}
</script>
</body>
</html>
