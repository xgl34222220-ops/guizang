		if streamed {
			w.Header().Set("Cache-Control", "no-cache")
		}
		w.WriteHeader(resp.StatusCode)

		var n int64
		var usage usageInfo
		if streamed {
			tail := &ringTail{cap: usageTailBytes}
			n, err = io.Copy(io.MultiWriter(w, tail), resp.Body)
			usage = parseStreamUsage(tail.buf)
		} else {
			payload, readErr := io.ReadAll(io.LimitReader(resp.Body, a.cfg.MaxBodyBytes+1))
			if readErr != nil {
				return resp.StatusCode, usageInfo{}, false, n, readErr
			}
			if int64(len(payload)) > a.cfg.MaxBodyBytes {
				return resp.StatusCode, usageInfo{}, false, n, errors.New("upstream response too large")
			}
			n = int64(len(payload))
			_, err = w.Write(payload)
			usage = parseUsage(payload)
		}
		return resp.StatusCode, usage, streamed, n, err
	}
	return 0, usageInfo{}, false, 0, lastErr
}

func (a *app) rewriteModelAlias(body []byte, current string) ([]byte, string) {
	if len(a.cfg.ModelAliases) == 0 {
		return body, current
	}
	var obj map[string]any
	if err := json.Unmarshal(body, &obj); err != nil {
		return body, current
	}
	m, _ := obj["model"].(string)
	if target, ok := a.cfg.ModelAliases[m]; ok && strings.TrimSpace(target) != "" {
		obj["model"] = target
		if out, err := json.Marshal(obj); err == nil {
			return out, target
		}
	}
	return body, current
}

func parseUsage(payload []byte) usageInfo {
	var root map[string]any
	if json.Unmarshal(payload, &root) != nil {
		return usageInfo{}
	}
	if u, ok := root["usage"].(map[string]any); ok {
		return usageInfo{Input: num(u, "prompt_tokens", "input_tokens"), Output: num(u, "completion_tokens", "output_tokens"), Total: num(u, "total_tokens")}
	}
	if u, ok := root["usageMetadata"].(map[string]any); ok {
		return usageInfo{Input: num(u, "promptTokenCount"), Output: num(u, "candidatesTokenCount"), Total: num(u, "totalTokenCount")}
	}
	return usageInfo{}
}

func parseStreamUsage(payload []byte) usageInfo {
	lines := strings.Split(string(payload), "\n")
	for i := len(lines) - 1; i >= 0; i-- {
		line := strings.TrimSpace(lines[i])
		if !strings.HasPrefix(line, "data:") {
			continue
		}
		data := strings.TrimSpace(strings.TrimPrefix(line, "data:"))
		if data == "" || data == "[DONE]" {
			continue
		}
		if u := parseUsage([]byte(data)); u.Total > 0 || u.Input > 0 || u.Output > 0 {
			return u
		}
	}
	return usageInfo{}
}

func extractModel(path string, body []byte) string {
	if len(body) > 0 {
		var obj map[string]any
		if json.Unmarshal(body, &obj) == nil {
			if m, ok := obj["model"].(string); ok {
				return m
			}
		}
	}
	if i := strings.Index(path, "/models/"); i >= 0 {
		s := path[i+len("/models/"):]
		if j := strings.IndexAny(s, "/:"); j >= 0 {
			s = s[:j]
		}
		return s
	}
	return ""
}

func num(m map[string]any, keys ...string) int64 {
	for _, k := range keys {
		switch v := m[k].(type) {
		case float64:
			return int64(v)
		case json.Number:
			n, _ := v.Int64()
			return n
		}
	}
	return 0
}

func retryableStatus(code int) bool {
	return code == http.StatusTooManyRequests || code == http.StatusBadGateway || code == http.StatusServiceUnavailable || code == http.StatusGatewayTimeout || code >= 500
}

func readBody(r *http.Request, maxBytes int64) ([]byte, error) {
	if r.Body == nil {
		return nil, nil
	}
	defer r.Body.Close()
	b, err := io.ReadAll(io.LimitReader(r.Body, maxBytes+1))
	if err != nil {
		return nil, err
	}
	if int64(len(b)) > maxBytes {
		return nil, fmt.Errorf("request body exceeds %d MB", maxBytes>>20)
	}
	return b, nil
}

func decodeJSON(r *http.Request, dst any, max int64) error {
	b, err := readBody(r, max)
	if err != nil {
		return err
	}
	if len(b) == 0 {
		return errors.New("JSON body required")
	}
	dec := json.NewDecoder(bytes.NewReader(b))
	dec.DisallowUnknownFields()
	return dec.Decode(dst)
}

func copyRequestHeaders(dst, src http.Header) {
	for k, vv := range src {
		if hopHeader(k) || strings.EqualFold(k, "Host") || strings.EqualFold(k, "Content-Length") {
			continue
		}
		for _, v := range vv {
			dst.Add(k, v)
		}
	}
}

func copyResponseHeaders(dst, src http.Header) {
	for k, vv := range src {
		if hopHeader(k) || strings.EqualFold(k, "Content-Length") {
			continue
		}
		for _, v := range vv {
			dst.Add(k, v)
		}
	}
}

func hopHeader(k string) bool {
	switch strings.ToLower(k) {
	case "connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade":
		return true
	default:
		return false
	}
}

func newClientKey() (string, error) {
	b := make([]byte, 32)
	if _, err := rand.Read(b); err != nil {
		return "", err
	}
	return "sk-gzg-" + base64.RawURLEncoding.EncodeToString(b), nil
}

func hashKey(s string) string {
	h := sha256.Sum256([]byte(s))
	return hex.EncodeToString(h[:])
}

func bearerToken(h string) string {
	parts := strings.Fields(h)
	if len(parts) == 2 && strings.EqualFold(parts[0], "Bearer") {
		return parts[1]
	}
	return ""
}

func subtleEqual(a, b string) bool {
	if a == "" || b == "" {
		return false
	}
	ha := sha256.Sum256([]byte(a))
	hb := sha256.Sum256([]byte(b))
	return bytes.Equal(ha[:], hb[:])
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.Header().Set("Cache-Control", "no-store")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}

func writeError(w http.ResponseWriter, status int, message string) {
	writeJSON(w, status, map[string]any{"error": map[string]any{"message": message, "type": http.StatusText(status)}})
}

func methodNotAllowed(w http.ResponseWriter, methods ...string) {
	w.Header().Set("Allow", strings.Join(methods, ", "))
	writeError(w, http.StatusMethodNotAllowed, "method not allowed")
}

func corsMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Access-Control-Allow-Origin", "*")
		w.Header().Set("Access-Control-Allow-Headers", "Authorization, Content-Type, X-Admin-Token")
		w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PATCH, DELETE, OPTIONS")
		if r.Method == http.MethodOptions {
			w.WriteHeader(http.StatusNoContent)
			return
		}
		next.ServeHTTP(w, r)
	})
}

func requestIDMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id := r.Header.Get("X-Request-Id")
		if id == "" {
			b := make([]byte, 8)
			_, _ = rand.Read(b)
			id = hex.EncodeToString(b)
		}
		w.Header().Set("X-Request-Id", id)
		next.ServeHTTP(w, r)
	})
}

func recoveryMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if rec := recover(); rec != nil {
				log.Printf("panic: %v", rec)
				writeError(w, http.StatusInternalServerError, "internal server error")
			}
		}()
		next.ServeHTTP(w, r)
	})
}

func minFloat(a, b float64) float64 {
	if a < b {
		return a
	}
	return b
}
