			writeError(w, http.StatusInternalServerError, "could not generate key")
			return
		}
		prefix := plain
		if len(prefix) > 14 {
			prefix = prefix[:14]
		}
		rec, err := a.store.createKey(in.Name, hashKey(plain), prefix, in.RPM, in.DailyTokenLimit, in.MonthlyTokenLimit)
		if err != nil {
			writeError(w, http.StatusInternalServerError, "could not create key")
			return
		}
		writeJSON(w, http.StatusCreated, map[string]any{
			"id":                  rec.ID,
			"name":                rec.Name,
			"key":                 plain,
			"prefix":              rec.Prefix,
			"rpm":                 rec.RPM,
			"daily_token_limit":   rec.DailyTokenLimit,
			"monthly_token_limit": rec.MonthlyTokenLimit,
			"created_at":          rec.CreatedAt,
			"warning":             "This plaintext key is shown only once.",
		})
	default:
		methodNotAllowed(w, http.MethodGet, http.MethodPost)
	}
}

func (a *app) handleAdminKeyByID(w http.ResponseWriter, r *http.Request) {
	idStr := strings.TrimPrefix(r.URL.Path, "/admin/api/keys/")
	id, err := strconv.ParseInt(strings.Trim(idStr, "/"), 10, 64)
	if err != nil || id <= 0 {
		writeError(w, http.StatusBadRequest, "invalid key id")
		return
	}
	switch r.Method {
	case http.MethodPatch:
		var in struct {
			Enabled           *bool  `json:"enabled"`
			RPM               *int   `json:"rpm"`
			DailyTokenLimit   *int64 `json:"daily_token_limit"`
			MonthlyTokenLimit *int64 `json:"monthly_token_limit"`
		}
		if err := decodeJSON(r, &in, 1<<20); err != nil {
			writeError(w, http.StatusBadRequest, err.Error())
			return
		}
		if in.RPM != nil && (*in.RPM <= 0 || *in.RPM > 10000) {
			writeError(w, http.StatusBadRequest, "rpm must be 1..10000")
			return
		}
		if in.DailyTokenLimit != nil && *in.DailyTokenLimit < 0 {
			writeError(w, http.StatusBadRequest, "daily_token_limit must be >= 0")
			return
		}
		if in.MonthlyTokenLimit != nil && *in.MonthlyTokenLimit < 0 {
			writeError(w, http.StatusBadRequest, "monthly_token_limit must be >= 0")
			return
		}
		rec, err := a.store.updateKey(id, in.Enabled, in.RPM, in.DailyTokenLimit, in.MonthlyTokenLimit)
		if errors.Is(err, os.ErrNotExist) {
			writeError(w, http.StatusNotFound, "key not found")
			return
		}
		if err != nil {
			writeError(w, http.StatusInternalServerError, "state error")
			return
		}
		a.limiters.Delete(id)
		writeJSON(w, http.StatusOK, rec)
	case http.MethodDelete:
		err := a.store.deleteKey(id)
		if errors.Is(err, os.ErrNotExist) {
			writeError(w, http.StatusNotFound, "key not found")
			return
		}
		if err != nil {
			writeError(w, http.StatusInternalServerError, "state error")
			return
		}
		a.limiters.Delete(id)
		w.WriteHeader(http.StatusNoContent)
	default:
		methodNotAllowed(w, http.MethodPatch, http.MethodDelete)
	}
}

func (a *app) handleGateway(w http.ResponseWriter, r *http.Request) {
	if r.Method == http.MethodOptions {
		w.WriteHeader(http.StatusNoContent)
		return
	}
	auth, err := a.authenticateClient(bearerToken(r.Header.Get("Authorization")))
	if err != nil {
		writeError(w, http.StatusUnauthorized, "invalid or disabled API key")
		return
	}
	if !a.allowRequest(auth.Record) {
		writeError(w, http.StatusTooManyRequests, "rate limit exceeded")
		return
	}
	if ok, reason := a.store.withinBudgets(auth.Record); !ok {
		writeError(w, http.StatusPaymentRequired, reason)
		return
	}

	body, err := readBody(r, a.cfg.MaxBodyBytes)
	if err != nil {
		writeError(w, http.StatusRequestEntityTooLarge, err.Error())
		return
	}

	model := extractModel(r.URL.Path, body)
	if strings.HasPrefix(r.URL.Path, "/v1/") && len(body) > 0 {
		body, model = a.rewriteModelAlias(body, model)
	}

	start := time.Now()
	status, usage, streamed, responseBytes, proxyErr := a.proxy(r.Context(), w, r, body)
	duration := time.Since(start).Milliseconds()
	if proxyErr != nil {
		log.Printf("proxy error path=%s status=%d duration_ms=%d err=%v", r.URL.Path, status, duration, proxyErr)
		if status == 0 {
			writeError(w, http.StatusBadGateway, "upstream request failed")
			status = http.StatusBadGateway
		}
	}
	_ = streamed
	_ = responseBytes
	a.store.recordUsage(auth.Record.ID, status, usage.Total)
}

func (a *app) authenticateClient(token string) (*authContext, error) {
	if token == "" {
		return nil, errors.New("missing token")
	}
	rec, err := a.store.authenticate(hashKey(token))
	if err != nil {
		return nil, err
	}
	return &authContext{Record: rec}, nil
}

func (a *app) allowRequest(rec apiKeyRecord) bool {
	v, ok := a.limiters.Load(rec.ID)
	if !ok {
		burst := float64(max(1, min(10, rec.RPM)))
		entry := &tokenBucket{rpm: rec.RPM, tokens: burst, last: time.Now()}
		actual, _ := a.limiters.LoadOrStore(rec.ID, entry)
		v = actual
	}
	b := v.(*tokenBucket)
	b.mu.Lock()
	defer b.mu.Unlock()
	if b.rpm != rec.RPM {
		b.rpm = rec.RPM
		b.tokens = float64(max(1, min(10, rec.RPM)))
		b.last = time.Now()
	}
	now := time.Now()
	elapsed := now.Sub(b.last).Seconds()
	b.last = now
	capacity := float64(max(1, min(10, b.rpm)))
	b.tokens = minFloat(capacity, b.tokens+elapsed*(float64(b.rpm)/60.0))
	if b.tokens < 1 {
		return false
	}
	b.tokens--
	return true
}

func (a *app) proxy(ctx context.Context, w http.ResponseWriter, original *http.Request, body []byte) (int, usageInfo, bool, int64, error) {
	var base, upstreamPath string
	native := strings.HasPrefix(original.URL.Path, "/gemini/")
	if native {
		base = nativeBase
		upstreamPath = strings.TrimPrefix(original.URL.Path, "/gemini")
	} else {
		base = openAIBase
		upstreamPath = strings.TrimPrefix(original.URL.Path, "/v1")
	}
	if !strings.HasPrefix(upstreamPath, "/") {
		upstreamPath = "/" + upstreamPath
	}

	u, _ := url.Parse(base + upstreamPath)
	q := original.URL.Query()
	q.Del("key")
	u.RawQuery = q.Encode()

	startIndex := int(a.upstreamN.Add(1)-1) % len(a.cfg.GeminiKeys)
	attempts := len(a.cfg.GeminiKeys)
	if attempts > 3 {
		attempts = 3
	}

	var lastErr error
	for attempt := 0; attempt < attempts; attempt++ {
		upstreamKey := a.cfg.GeminiKeys[(startIndex+attempt)%len(a.cfg.GeminiKeys)]
		req, err := http.NewRequestWithContext(ctx, original.Method, u.String(), bytes.NewReader(body))
		if err != nil {
			return 0, usageInfo{}, false, 0, err
		}
		copyRequestHeaders(req.Header, original.Header)
		req.Header.Set("User-Agent", serverUserAgent)
		req.Header.Del("Authorization")
		req.Header.Del("X-Goog-Api-Key")
		if native {
			req.Header.Set("X-Goog-Api-Key", upstreamKey)
		} else {
			req.Header.Set("Authorization", "Bearer "+upstreamKey)
		}

		resp, err := a.client.Do(req)
		if err != nil {
			lastErr = err
			continue
		}
		if retryableStatus(resp.StatusCode) && attempt+1 < attempts {
			_, _ = io.CopyN(io.Discard, resp.Body, 64<<10)
			_ = resp.Body.Close()
			lastErr = fmt.Errorf("upstream status %d", resp.StatusCode)
			continue
		}
		defer resp.Body.Close()

		copyResponseHeaders(w.Header(), resp.Header)
		w.Header().Set("X-Accel-Buffering", "no")
		streamed := strings.Contains(strings.ToLower(resp.Header.Get("Content-Type")), "text/event-stream")
