<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>归藏 · Gemini Gateway</title>
<style>
:root{color-scheme:dark;--bg:#090b10;--glass:rgba(255,255,255,.055);--glass2:rgba(255,255,255,.08);--text:#f4f6fb;--muted:#959dab;--line:rgba(255,255,255,.09);--ok:#62d69c;--bad:#ff7e84;--accent:#8bb8ff;--shadow:0 18px 54px rgba(0,0,0,.32)}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 12% -10%,#182438 0,transparent 30%),radial-gradient(circle at 90% 0,#241b37 0,transparent 26%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}.shell{max-width:1100px;margin:auto;padding:32px 18px 70px}.top{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:24px}.brand h1{margin:0;font-size:26px;letter-spacing:-.7px}.brand p{margin:8px 0 0;color:var(--muted);font-size:13px}.pill{padding:9px 12px;border-radius:999px;background:var(--glass);box-shadow:inset 0 1px rgba(255,255,255,.09);font-size:12px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card{background:linear-gradient(180deg,var(--glass2),var(--glass));border-radius:20px;box-shadow:var(--shadow),inset 0 1px rgba(255,255,255,.08);padding:18px}.metric .k{color:var(--muted);font-size:12px}.metric .v{font-size:26px;font-weight:700;margin-top:8px;letter-spacing:-.6px}.panel{margin-top:14px}.panelhead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px}.panelhead h2{font-size:17px;margin:0}.btn{border:0;border-radius:14px;padding:11px 14px;background:rgba(139,184,255,.16);color:#dce9ff;box-shadow:inset 0 1px rgba(255,255,255,.1);cursor:pointer;font-weight:650}.btn:hover{background:rgba(139,184,255,.22)}.btn.danger{background:rgba(255,126,132,.12);color:#ffc9cc}.btn.ghost{background:rgba(255,255,255,.06);color:var(--muted)}.tablewrap{overflow:auto;border-radius:16px;background:rgba(0,0,0,.12)}table{width:100%;border-collapse:collapse;min-width:780px}th,td{text-align:left;padding:13px 14px;border-bottom:1px solid var(--line);font-size:13px}th{font-size:11px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.6px}tr:last-child td{border:0}.status{display:inline-flex;align-items:center;gap:7px}.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 16px rgba(98,214,156,.5)}.dot.off{background:var(--bad);box-shadow:none}.modal{position:fixed;inset:0;background:rgba(3,5,8,.72);backdrop-filter:blur(18px);display:none;align-items:center;justify-content:center;padding:18px}.modal.show{display:flex}.dialog{width:min(480px,100%);background:#121720;border-radius:24px;padding:22px;box-shadow:0 28px 80px rgba(0,0,0,.5),inset 0 1px rgba(255,255,255,.09)}.dialog h3{margin:0 0 18px}.field{margin:12px 0}.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:7px}.input{width:100%;border:0;outline:0;border-radius:14px;background:rgba(255,255,255,.07);box-shadow:inset 0 1px rgba(255,255,255,.08);padding:13px;color:var(--text);font-size:14px}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.actions{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}.login{max-width:450px;margin:12vh auto 0}.login h2{margin:0 0 8px}.login p{color:var(--muted);font-size:13px;line-height:1.7}.keybox{background:#080b10;border-radius:14px;padding:14px;word-break:break-all;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;margin:12px 0;color:#d8e7ff}.hidden{display:none!important}.muted{color:var(--muted)}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.small{font-size:12px}.toast{position:fixed;right:18px;bottom:18px;padding:12px 14px;background:#1a202b;border-radius:14px;box-shadow:var(--shadow);opacity:0;transform:translateY(8px);transition:.2s;pointer-events:none}.toast.show{opacity:1;transform:none}@media(max-width:780px){.grid{grid-template-columns:1fr 1fr}.shell{padding-top:22px}.top{align-items:start;flex-direction:column}.card{border-radius:18px}.metric .v{font-size:22px}}@media(max-width:430px){.grid{grid-template-columns:1fr 1fr;gap:9px}.card{padding:15px}.metric .v{font-size:20px}.brand h1{font-size:23px}}
</style>
</head>
<body>
<div id="login" class="shell login">
  <div class="card">
    <h2>归藏 · Gemini Gateway</h2>
    <p>输入部署时生成的 ADMIN_TOKEN。管理令牌只保存在当前浏览器，不会发送给第三方。</p>
    <div class="field"><label>ADMIN_TOKEN</label><input id="token" class="input" type="password" autocomplete="current-password" placeholder="输入管理令牌" /></div>
    <button class="btn" style="width:100%" onclick="login()">进入管理台</button>
  </div>
</div>

<div id="app" class="shell hidden">
  <div class="top"><div class="brand"><h1>归藏 · Gemini Gateway</h1><p>Gemini-only 私人 API 网关 · 默认不保存 Prompt / Response 正文</p></div><div class="pill">/v1 · /gemini</div></div>
  <div class="grid">
    <div class="card metric"><div class="k">今日请求</div><div class="v" id="todayReq">—</div></div>
    <div class="card metric"><div class="k">今日 Token</div><div class="v" id="todayTok">—</div></div>
    <div class="card metric"><div class="k">本月 Token</div><div class="v" id="monthTok">—</div></div>
    <div class="card metric"><div class="k">活跃密钥</div><div class="v" id="activeKeys">—</div></div>
  </div>
  <div class="card panel">
    <div class="panelhead"><div><h2>用户 / API Key</h2><div class="small muted" style="margin-top:6px">每个人独立 Key，可单独限速、限额与禁用。</div></div><button class="btn" onclick="showCreate()">＋ 创建密钥</button></div>
