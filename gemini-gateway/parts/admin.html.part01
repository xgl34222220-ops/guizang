<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>归藏 · Gemini Gateway</title>
<style>
:root{color-scheme:dark;--bg:#090b10;--card:#121720cc;--text:#f4f6fb;--muted:#98a0ae;--line:#ffffff14;--accent:#8bb8ff;--ok:#62d69c;--bad:#ff7e84}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 10% 0,#182438 0,transparent 28%),var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;min-height:100vh}
main{max-width:1050px;margin:auto;padding:28px 16px 60px}h1{font-size:26px;margin:0}p{color:var(--muted)}.top,.row{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:20px 0}.card{background:var(--card);border-radius:18px;padding:16px;box-shadow:0 18px 50px #0006,inset 0 1px #ffffff12}.k{font-size:12px;color:var(--muted)}.v{font-size:24px;font-weight:750;margin-top:7px}.btn,input{border:0;border-radius:12px;padding:11px 13px;background:#ffffff0f;color:var(--text);outline:0}.btn{cursor:pointer;background:#8bb8ff22;color:#dce9ff;font-weight:650}.danger{color:#ffc7ca;background:#ff7e841a}.small{font-size:12px;color:var(--muted)}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);font-size:13px}th{color:var(--muted);font-size:11px}.table{overflow:auto}.login{max-width:440px;margin:18vh auto}.hidden{display:none}.modal{position:fixed;inset:0;background:#000b;backdrop-filter:blur(14px);display:none;place-items:center;padding:18px}.modal.show{display:grid}.dialog{width:min(470px,100%);background:#121720;border-radius:20px;padding:20px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fields input:first-child{grid-column:1/-1}.key{padding:12px;background:#080b10;border-radius:12px;word-break:break-all;font-family:monospace}
@media(max-width:720px){.grid{grid-template-columns:1fr 1fr}.v{font-size:20px}}
</style></head><body>
<main id="login" class="login"><div class="card"><h1>归藏 · Gemini Gateway</h1><p>输入服务器的 ADMIN_TOKEN 进入管理台。</p><input id="token" type="password" placeholder="ADMIN_TOKEN" style="width:100%"><button class="btn" style="width:100%;margin-top:10px" onclick="login()">进入管理台</button></div></main>
<main id="app" class="hidden"><div class="top"><div><h1>归藏 · Gemini Gateway</h1><p>Gemini-only 私人 API 网关 · 默认不保存 Prompt / Response 正文</p></div><button class="btn" onclick="logout()">退出</button></div>
<div class="grid"><div class="card"><div class="k">今日请求</div><div id="req" class="v">—</div></div><div class="card"><div class="k">今日 Token</div><div id="tok" class="v">—</div></div><div class="card"><div class="k">本月 Token</div><div id="month" class="v">—</div></div><div class="card"><div class="k">活跃 Key</div><div id="active" class="v">—</div></div></div>
<div class="card"><div class="row"><div><b>用户 / API Key</b><div class="small">每个人独立 Key，可限制 RPM 与 Token。</div></div><button class="btn" onclick="openCreate()">＋ 创建密钥</button></div><div class="table"><table><thead><tr><th>名称</th><th>Key</th><th>状态</th><th>RPM</th><th>日 Token</th><th>月 Token</th><th>操作</th></tr></thead><tbody id="keys"></tbody></table></div></div>
<div class="card" style="margin-top:12px"><b>接入地址</b><div class="key" id="base" style="margin-top:10px"></div></div></main>
<div id="create" class="modal"><div class="dialog"><h3>创建 API Key</h3><div class="fields"><input id="name" placeholder="名称，如 Muse"><input id="rpm" type="number" value="60" min="1" placeholder="RPM"><input id="daily" type="number" value="0" min="0" placeholder="每日 Token，0=不限"><input id="monthly" type="number" value="0" min="0" placeholder="每月 Token，0=不限"></div><div class="row" style="justify-content:flex-end;margin-top:14px"><button class="btn" onclick="closeCreate()">取消</button><button class="btn" onclick="createKey()">创建</button></div></div></div>
<div id="shown" class="modal"><div class="dialog"><h3>API Key 已创建</h3><p>明文只显示这一次，请立即保存。</p><div id="plain" class="key"></div><div class="row" style="justify-content:flex-end;margin-top:14px"><button class="btn" onclick="copyKey()">复制</button><button class="btn" onclick="closeShown()">完成</button></div></div></div>
<script>
let T=localStorage.getItem('gzg_admin_token')||'',P='';
const $=s=>document.querySelector(s),fmt=n=>{n=Number(n||0);return n>=1e9?(n/1e9).toFixed(2)+'B':n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':String(n)};
async function api(path,opt={}){opt.headers={...(opt.headers||{}),'Content-Type':'application/json','X-Admin-Token':T};const r=await fetch(path,opt);if(r.status===401){logout();throw Error('管理令牌无效')}if(!r.ok){let j={};try{j=await r.json()}catch{};throw Error(j?.error?.message||'HTTP '+r.status)}return r.status===204?null:r.json()}
async function login(){T=$('#token').value.trim();if(!T)return;localStorage.setItem('gzg_admin_token',T);try{await load();$('#login').classList.add('hidden');$('#app').classList.remove('hidden')}catch(e){alert(e.message)}}
function logout(){localStorage.removeItem('gzg_admin_token');T='';$('#app').classList.add('hidden');$('#login').classList.remove('hidden')}
async function load(){const [s,ks]=await Promise.all([api('/admin/api/stats'),api('/admin/api/keys')]);$('#req').textContent=fmt(s.today_requests);$('#tok').textContent=fmt(s.today_tokens);$('#month').textContent=fmt(s.month_tokens);$('#active').textContent=s.active_keys+'/'+s.keys;$('#base').textContent='OpenAI: '+location.origin+'/v1\nGemini 原生: '+location.origin+'/gemini';render(ks)}
function render(ks){$('#keys').innerHTML=ks.map(k=>'<tr><td>'+esc(k.name)+'</td><td><code>'+esc(k.prefix)+'••••</code></td><td>'+(k.enabled?'正常':'已禁用')+'</td><td>'+k.rpm+'</td><td>'+(k.daily_token_limit?fmt(k.daily_token_limit):'不限')+'</td><td>'+(k.monthly_token_limit?fmt(k.monthly_token_limit):'不限')+'</td><td><button class="btn" onclick="toggle('+k.id+','+(!k.enabled)+')">'+(k.enabled?'禁用':'启用')+'</button> <button class="btn danger" onclick="del('+k.id+')">删除</button></td></tr>').join('')}
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function openCreate(){$('#create').classList.add('show')}function closeCreate(){$('#create').classList.remove('show')}
async function createKey(){try{const b={name:$('#name').value.trim(),rpm:Number($('#rpm').value||60),daily_token_limit:Number($('#daily').value||0),monthly_token_limit:Number($('#monthly').value||0)};const x=await api('/admin/api/keys',{method:'POST',body:JSON.stringify(b)});P=x.key;$('#plain').textContent=P;closeCreate();$('#shown').classList.add('show');await load()}catch(e){alert(e.message)}}
function closeShown(){P='';$('#plain').textContent='';$('#shown').classList.remove('show')}async function copyKey(){await navigator.clipboard.writeText(P)}
async function toggle(id,enabled){await api('/admin/api/keys/'+id,{method:'PATCH',body:JSON.stringify({enabled})});await load()}
async function del(id){if(!confirm('确定删除这个 Key？'))return;await api('/admin/api/keys/'+id,{method:'DELETE'});await load()}
if(T){load().then(()=>{$('#login').classList.add('hidden');$('#app').classList.remove('hidden')}).catch(()=>logout())}
</script></body></html>