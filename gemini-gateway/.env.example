# Required. Keep these only on the server.
GEMINI_API_KEYS=YOUR_GEMINI_AUTH_KEY
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional
PORT=8080
STATE_PATH=/data/gateway.json
MAX_BODY_MB=32
REQUEST_TIMEOUT_SECONDS=600

# Client-facing aliases. JSON object.
MODEL_ALIASES={"gemini":"gemini-3.1-pro-preview","gemini-fast":"gemini-3.8-flash"}
